# --- Database ---
# Dev default is zero-config SQLite (no value needed).
# docker-compose sets this to the Postgres service automatically.
# DATABASE_URL=postgresql+asyncpg://orbit:orbit@localhost:5432/orbit

# --- Redis (optional; enables caching + agent event streams) ---
# REDIS_URL=redis://localhost:6379/0

# --- Demo data (seeds the Northwind sample dataset on first boot) ---
# Set to false to start with an empty database.
# SEED_DEMO=false

# --- CORS (Next.js frontend origins) ---
# CORS_ORIGINS=["http://localhost:3000"]

# --- Orbit Calls + Google Calendar (real OAuth — no mock) ---
# 1. console.cloud.google.com → APIs & Services → enable "Google Calendar API"
# 2. OAuth consent screen → External → add yourself as a test user
# 3. Credentials → Create credentials → OAuth client ID → Web application
#    Authorized redirect URI: http://localhost:8000/calendar/oauth/callback
# GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/oauth/callback
# FRONTEND_URL=http://localhost:3000   # used to build /call/{room} links

# --- Auth (Clerk). Leave unset to run the API open in dev/demo. ---
# CLERK_JWKS_URL=https://your-tenant.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://your-tenant.clerk.accounts.dev

# --- AI / LLM provider (provider-agnostic via PydanticAI) ---
# The agent pipeline only calls a live model when ENABLE_AI=true. Otherwise it
# uses deterministic, transcript-derived fallbacks (fully runnable offline).
# Switching providers is an env change only — no code change.
#
# ENABLE_AI=true
#
# Free dev — Google Gemini (free API key from https://aistudio.google.com):
#   DEFAULT_MODEL=google-gla:gemini-2.0-flash
#   LLM_API_KEY=AIza...
#
# Free dev — Ollama (fully local, no key; install Ollama + `ollama pull llama3.2`):
#   DEFAULT_MODEL=ollama:llama3.2
#   # OLLAMA_BASE_URL=http://localhost:11434/v1   # only if not the default
#
# Production — Anthropic Claude:
#   DEFAULT_MODEL=anthropic:claude-opus-4-8
#   LLM_API_KEY=sk-ant-...
#
# OpenAI also works out of the box (DEFAULT_MODEL=openai:gpt-4o-mini + LLM_API_KEY).
# Other providers (groq, mistral, …) need their optional package, e.g.
#   pip install "pydantic-ai-slim[groq]"   +   the provider's standard env var.
