# --- Database ---
# Dev default is zero-config SQLite (no value needed).
# docker-compose sets this to the Postgres service automatically.
# DATABASE_URL=postgresql+asyncpg://orbit:orbit@localhost:5432/orbit

# --- Redis (optional; enables caching + agent event streams) ---
# REDIS_URL=redis://localhost:6379/0

# --- Demo data (seeds the Northwind sample dataset on first boot) ---
# Set to false to start with an empty database.
# SEED_DEMO=false

# --- CORS (Next.js frontend origins) ---
# CORS_ORIGINS=["http://localhost:3000"]

# --- Orbit Calls + Google Calendar (real OAuth — no mock) ---
# 1. console.cloud.google.com → APIs & Services → enable "Google Calendar API"
# 2. OAuth consent screen → External → add yourself as a test user
# 3. Credentials → Create credentials → OAuth client ID → Web application
#    Authorized redirect URI: http://localhost:8000/calendar/oauth/callback
# GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_REDIRECT_URI=http://localhost:8000/calendar/oauth/callback
# FRONTEND_URL=http://localhost:3000   # used to build /call/{room} links

# --- Zoom (real OAuth — imports cloud-recording transcripts into Meetings) ---
# 1. marketplace.zoom.us → Develop → Build App → General App
# 2. OAuth Redirect URL: http://localhost:8000/zoom/oauth/callback
# 3. Scopes: user:read:user + cloud_recording:read:list_user_recordings
#    (classic apps: user:read + recording:read)
# ZOOM_CLIENT_ID=...
# ZOOM_CLIENT_SECRET=...
# ZOOM_REDIRECT_URI=http://localhost:8000/zoom/oauth/callback

# --- Linear OAuth ("Connect with Linear"). Optional — the personal API-key
#     connect path works without any of this. When set, the one-click button
#     appears. Long-lived token, no refresh. ---
# 1. linear.app/settings/api/applications/new
# 2. Callback URL (must match exactly): http://localhost:8000/integrations/linear/oauth/callback
# 3. Scopes requested: read,write
# LINEAR_CLIENT_ID=...
# LINEAR_CLIENT_SECRET=...
# LINEAR_REDIRECT_URI=http://localhost:8000/integrations/linear/oauth/callback

# --- Slack OAuth ("Connect Slack"). Optional. Ingests threads from the channels
#     you add the Orbit bot to. When unset, Slack shows as coming-soon. ---
# 1. api.slack.com/apps → Create New App
# 2. OAuth & Permissions → Redirect URL: http://localhost:8000/integrations/slack/oauth/callback
# 3. Bot Token Scopes: channels:history, channels:read, groups:history, users:read
# 4. Install to workspace, then invite the bot to the channels Orbit should watch
# SLACK_CLIENT_ID=...
# SLACK_CLIENT_SECRET=...
# SLACK_REDIRECT_URI=http://localhost:8000/integrations/slack/oauth/callback

# --- Auth (Clerk). Leave unset to run the API open in dev/demo. ---
# CLERK_JWKS_URL=https://your-tenant.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://your-tenant.clerk.accounts.dev

# --- AI / LLM provider (provider-agnostic via PydanticAI) ---
# The agent pipeline only calls a live model when ENABLE_AI=true. Otherwise it
# uses deterministic, transcript-derived fallbacks (fully runnable offline).
# Switching providers is an env change only — no code change.
#
# ENABLE_AI=true
#
# Models are keyed on ENVIRONMENT (config.py): development (the default) picks
# free-tier Gemini models, ENVIRONMENT=production picks the refined ones.
#   development → google-gla:gemini-3.5-flash-lite + gemini-embedding-001
#   production  → google-gla:gemini-3.6-flash      + gemini-embedding-2
# (gemini-2.0-flash was SHUT DOWN 2026-06-01 — never configure it again.)
# Explicit vars always override the environment defaults:
#   DEFAULT_MODEL=google-gla:gemini-3.6-flash
#   EMBEDDING_MODEL=gemini-embedding-2
#   LLM_API_KEY=AIza...   # key from https://aistudio.google.com
# CAUTION: vectors from different embedding models are incompatible. Change
# EMBEDDING_MODEL only on a fresh DB, or null the stored embedding columns so
# the startup backfill re-embeds everything with the new model.
#
# Free dev — Ollama (fully local, no key; install Ollama + `ollama pull llama3.2`):
#   DEFAULT_MODEL=ollama:llama3.2
#   # OLLAMA_BASE_URL=http://localhost:11434/v1   # only if not the default
#
# Production — Anthropic Claude:
#   DEFAULT_MODEL=anthropic:claude-opus-4-8
#   LLM_API_KEY=sk-ant-...
#
# OpenAI also works out of the box (DEFAULT_MODEL=openai:gpt-4o-mini + LLM_API_KEY).
# Other providers (groq, mistral, …) need their optional package, e.g.
#   pip install "pydantic-ai-slim[groq]"   +   the provider's standard env var.

# --- MCP (external AI agents: Claude Code, Cursor, …) -----------------------
# Bearer key for the read-only /mcp endpoint. Required on any deployment where
# Clerk auth is on (unset there = /mcp refuses with 503). Unset locally = open
# dev access on ws_default, matching the rest of the dev API.
# MCP_API_KEY=generate-a-long-random-string

# --- Beta credit requests ---------------------------------------------------
# One credit = one answered chat; each person starts at workspaces.credit_default.
# When someone runs out, "Request credits" mails ALERT_EMAIL through Resend.
# Without RESEND_API_KEY (or before the sender domain is verified) the request
# falls back to a Linear issue via ORBIT_LINEAR_API_KEY, so it is never lost.
# RESEND_API_KEY=re_...
# ALERT_EMAIL=you@yourcompany.com
# MAIL_FROM=Orbit <notifications@yourdomain.com>   # must be a Resend-verified domain

# --- Notion / Confluence (document sensors) ---------------------------------
# Notion: https://www.notion.so/my-integrations → public integration. The user
# picks which pages to share during authorization; tokens never expire.
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=http://localhost:8000/integrations/notion/oauth/callback
#
# Confluence: developer.atlassian.com → OAuth 2.0 (3LO) app with scopes
# read:page:confluence read:space:confluence offline_access. offline_access is
# what yields a refresh token; Atlassian ROTATES it on every refresh.
# CONFLUENCE_CLIENT_ID=
# CONFLUENCE_CLIENT_SECRET=
# CONFLUENCE_REDIRECT_URI=http://localhost:8000/integrations/confluence/oauth/callback
