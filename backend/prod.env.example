# Orbit backend — PRODUCTION env template (Cloud Run, scale-to-zero + Cloud Scheduler).
# Put the real values in Secret Manager and inject with `gcloud run ... --set-secrets`.
# NEVER commit the filled-in version. (Frontend NEXT_PUBLIC_* vars are BUILD ARGS — see bottom.)

# --- Security gates (get these wrong and the app is open / loses data) --------
CLERK_JWKS_URL=https://<your-prod>.clerk.accounts.dev/.well-known/jwks.json   # REQUIRED — unset = NO AUTH (everyone is the demo user)
CLERK_ISSUER=https://<your-prod>.clerk.accounts.dev
SEED_DEMO=false                                # do not seed fake data in prod
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/orbit   # Postgres+pgvector (Neon/Supabase free tier OK). Run: CREATE EXTENSION vector;

# --- Public URLs (webhooks, OAuth redirects, CORS) ----------------------------
PUBLIC_API_URL=https://api.your-domain.com     # webhook URLs are built from this
FRONTEND_URL=https://app.your-domain.com       # post-OAuth redirect target
CORS_ORIGINS=["https://app.your-domain.com"]

# --- Heartbeat: scale-to-zero mode (no always-on instance) --------------------
HEARTBEAT_ENABLED=false                         # OFF = don't run the in-process loop
HEARTBEAT_TOKEN=<long-random-secret>            # Cloud Scheduler sends this in X-Heartbeat-Token
HEARTBEAT_INTERVAL_MINUTES=30                    # informational in scheduler mode; the schedule sets cadence
# (Prefer always-on instead? set HEARTBEAT_ENABLED=true and Cloud Run --min-instances=1 — costs more.)

# --- AI / models --------------------------------------------------------------
ENABLE_AI=true
# Two-tier: smart (reasoning+thinking) / bulk (extraction, vision, classifiers).
# Same architecture as dev — prod just swaps the names. For paid prod quality:
#   DEFAULT_MODEL=anthropic:claude-sonnet-5
#   EXTRACTOR_MODEL=anthropic:claude-haiku-4-5-20251001
DEFAULT_MODEL=google-gla:gemini-flash-latest
EXTRACTOR_MODEL=google-gla:gemini-flash-lite-latest
LLM_API_KEY=<prod-gemini-key>
DEEPGRAM_API_KEY=<deepgram-member-key>          # server-only; Orbit Mac receives 30-second STT tokens

# --- OAuth: prod redirect URIs (ALSO register each in the provider's console) --
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.your-domain.com/calendar/oauth/callback
GDRIVE_REDIRECT_URI=https://api.your-domain.com/integrations/google-drive/oauth/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=https://api.your-domain.com/integrations/linear/oauth/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://api.your-domain.com/integrations/slack/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://api.your-domain.com/integrations/github/oauth/callback

# --- Frontend BUILD ARGS (passed to `docker build` for orbit-web, not runtime) --
# NEXT_PUBLIC_API_URL=https://api.your-domain.com
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
